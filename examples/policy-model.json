      "auth": "authenticated",
      "expected": "deny"
    },
    {
      "role": "member",
      "action": "view",
      "resource": "profile",
      "relationship": "same_tenant",
      "auth": "anonymous",
      "expected": "deny"
    },
    {
      "role": "member",
      "action": "view",
      "resource": "profile",
      "relationship": "other_tenant",
      "auth": "authenticated",
      "expected": "deny"
    },
    {
      "role": "member",
      "action": "view",
      "resource": "profile",
